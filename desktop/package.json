{
  "name": "supermarket-pos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Supermarket Cashier Desktop System - Electron + React + TypeScript client",
  "author": "kiky",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "vite": "vite",
    "dev": "cross-env NODE_ENV=development concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:vite\" \"wait-on http-get://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "electron": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.kiky.supermarketpos",
    "productName": "Supermarket POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/__tests__/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "node-thermal-printer": "^4.6.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "keytar": "^7.9.0",
    "serialport": "^13.0.0",
    "usb": "^3.0.1"
  }
}
